# Financial Modeling Prep — https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Optional: deepseek-v4-flash (default, fast) or deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash

# Supabase — optional. App runs without these (fixtures + in-memory cache).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local / agent ingest for CCASS and US ownership snapshots. Never expose to the browser.
RESEARCH_INGEST_TOKEN=
INVESTMOUSE_API_URL=https://your-app.vercel.app/api/ownership/ingest
# Optional: space-separated list for the weekday launchd job
# OWNERSHIP_TICKERS=9988.HK 0700.HK NVDA AAPL

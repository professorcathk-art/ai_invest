# Financial Modeling Prep — free key: https://site.financialmodelingprep.com/register
# Dashboard: https://site.financialmodelingprep.com/developer/docs/dashboard
FMP_API_KEY=

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Optional: deepseek-v4-flash (default, fast) or deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash

# Supabase — optional. App runs without these (fixtures + in-memory cache).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local / agent ingest for CCASS and US ownership snapshots. Never expose to the browser.
RESEARCH_INGEST_TOKEN=
INVESTMOUSE_API_URL=https://your-app.vercel.app/api/ownership/ingest
# Optional site origin for iMac warmers / sector digest POSTs
# INVESTMOUSE_SITE_URL=https://your-app.vercel.app
# iMac 24/7 jobs (scripts/install_imac_jobs.sh). Times are the Mac's local clock.
# INVESTMOUSE_SITE_URL=http://127.0.0.1:3030
# CCASS_LOOKBACK=1
# Optional: override scripts/ownership_tickers.txt (space-separated)
# OWNERSHIP_TICKERS=9988.HK 0700.HK NVDA AAPL
